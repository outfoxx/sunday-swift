","anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The new "},{"code":"ServerTrustPolicyManager","type":"codeVoice"},{"text":" instance.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Since different servers and web services can have different leaf certificates, intermediate and even root"},{"type":"text","text":" "},{"type":"text","text":"certficates, it is important to have the flexibility to specify evaluation policies on a per host basis. This"},{"type":"text","text":" "},{"type":"text","text":"allows for scenarios such as using default evaluation for host1, certificate pinning for host2, public key"},{"type":"text","text":" "},{"type":"text","text":"pinning for host3 and disabling evaluation for host4."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Sunday/documentation/Sunday/ServerTrustPolicyManager":{"identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicyManager","type":"topic","kind":"symbol","abstract":[{"text":"Responsible for managing the mapping of ","type":"text"},{"code":"ServerTrustPolicy","type":"codeVoice"},{"text":" objects to a given host.","type":"text"}],"url":"\/documentation\/sunday\/servertrustpolicymanager","title":"ServerTrustPolicyManager","role":"symbol","navigatorTitle":[{"text":"ServerTrustPolicyManager","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ServerTrustPolicyManager","kind":"identifier"}]},"doc://Sunday/documentation/Sunday/ServerTrustPolicyManager/init(policies:)":{"title":"init(policies:)","abstract":[{"text":"Initializes the ","type":"text"},{"type":"codeVoice","code":"ServerTrustPolicyManager"},{"text":" instance with the given policies.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/sunday\/servertrustpolicyma