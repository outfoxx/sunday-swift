 default evaluation for host1, certificate pinning for host2, public key"},{"type":"text","text":" "},{"type":"text","text":"pinning for host3 and disabling evaluation for host4."}]}],"kind":"content"}],"sections":[],"metadata":{"modules":[{"name":"Sunday"}],"title":"init(policies:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"policies"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"ServerTrustPolicy","preciseIdentifier":"s:6Sunday17ServerTrustPolicyO"},{"kind":"text","text":"])"}],"symbolKind":"init","roleHeading":"Initializer","externalID":"s:6Sunday24ServerTrustPolicyManagerC8policiesACSDySSAA0bcD0OG_tcfc","role":"symbol"},"variants":[{"paths":["\/documentation\/sunday\/servertrustpolicymanager\/init(policies:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://Sunday/documentation/Sunday":{"title":"Sunday","type":"topic","url":"\/documentation\/sunday","kind":"symbol","abstract":[],"identifier":"doc:\/\/Sunday\/documentation\/Sunday","role":"collection"},"doc://Sunday/documentation/Sunday/ServerTrustPolicyManager/init(policies:)":{"abstract":[{"type":"text","text":"Initializes the "},{"type":"codeVoice","code":"ServerTrustPolicyManager"},{"type":"text","text":" instance with the given policies."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicyManager\/init(policies:)","url":"\/documentation\/sunday\/servertrustpolicymanager\/init(policies:)","type":"topic","title":"init(policies:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"policies"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:6Sunday17ServerTrustPolicyO","kind":"typeIdentifier","text":"ServerTrustPolicy"},{"kind":"text","text":"])"}]},"doc://Sunday/documentation/Sunday/ServerTrustPolicyManager":{"identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicyManager","role":"symbol","abstract":[{"type":"text","text":"Responsible for managing the mapping of "},{"type":"codeVoice","code":"ServerTrustPolicy"},{"type":"text","text":" objects to a given host."}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ServerTrustPolicyManager","kind":"identifier"}],"title":"ServerTrustPolicyManager","navigatorTitle":[{"text":"ServerTrustPolicyManager","kind":"identifier"}],"url":"\/documentation\/sunday\/servertrustpolicymanager","kind":"symbol"},"doc://Sunday/documentation/Sunday/ServerTrustPolicy":{"identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicy","role":"symbol","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ServerTrustPolicy"},{"type":"text","text":" evaluates the server trust generally provided by an "},{"type":"codeVoice","code":"NSURLAuthenticationChallenge"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"connecting to a server over a secure HTTPS connection. The policy configuration then evaluates the server trust"},{"type":"text","text":" "},{"type":"text","text":"with a given set of criteria to determine whether the server trust is valid and the connection should be made."}],"type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ServerTrustPolicy"}],"title":"ServerTrustPolicy","navigatorTitle":[{"kind":"identifier","text":"ServerTrustPolicy"}],"url":"\/documentation\/sunday\/servertrustpolicy","kind":"symbol"}}}