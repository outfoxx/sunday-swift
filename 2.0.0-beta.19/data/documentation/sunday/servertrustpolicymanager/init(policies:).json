erverTrustPolicy","type":"codeVoice"},{"type":"text","text":" objects to a given host."}],"navigatorTitle":[{"text":"ServerTrustPolicyManager","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ServerTrustPolicyManager","kind":"identifier"}],"url":"\/documentation\/sunday\/servertrustpolicymanager","title":"ServerTrustPolicyManager","kind":"symbol","identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicyManager","type":"topic","role":"symbol"},"doc://Sunday/documentation/Sunday":{"url":"\/documentation\/sunday","type":"topic","title":"Sunday","abstract":[],"role":"collection","kind":"symbol","identifier":"doc:\/\/Sunday\/documentation\/Sunday"},"doc://Sunday/documentation/Sunday/ServerTrustPolicy":{"kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ServerTrustPolicy"},{"type":"text","text":" evaluates the server trust generally provided by an "},{"type":"codeVoice","code":"NSURLAuthenticationChallenge"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"connecting to a server over a secure HTTPS connection. The policy configuration then evaluates the server trust"},{"type":"text","text":" "},{"type":"text","text":"with a given set of criteria to determine whether the server trust is valid and the connection should be made."}],"identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicy","title":"ServerTrustPolicy","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ServerTrustPolicy"}],"url":"\/documentation\/sunday\/servertrustpolicy","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ServerTrustPolicy"}]}}}