,{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bundle","preciseIdentifier":"c:objc(cs)NSBundle"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"SecKey","preciseIdentifier":"c:@T@SecKeyRef"},{"kind":"text","text":"]"}],"role":"symbol"},"doc://Sunday/documentation/Sunday/ServerTrustPolicy/evaluate(_:forHost:)":{"role":"symbol","title":"evaluate(_:forHost:)","url":"\/documentation\/sunday\/servertrustpolicy\/evaluate(_:forhost:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"evaluate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SecTrust","kind":"typeIdentifier","preciseIdentifier":"c:@T@SecTrustRef"},{"text":", ","kind":"text"},{"text":"forHost","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicy\/evaluate(_:forHost:)","type":"topic","abstract":[{"text":"Evaluates whether the server trust is valid for the given host.","type":"text"}],"kind":"symbol"},"doc://Sunday/documentation/Sunday/ServerTrustPolicy/certificates(in:)":{"url":"\/documentation\/sunday\/servertrustpolicy\/certificates(in:)","kind":"symbol","abstract":[{"text":"Returns all certificates within the given bundle with a ","type":"text"},{"type":"codeVoice","code":".cer"},{"text":", ","type":"text"},{"type":"codeVoice","code":".CER"},{"text":", ","type":"text"},{"type":"codeVoice","code":".crt"},{"text":", ","type":"text"},{"type":"codeVoice","code":".CRT"},{"text":", ","type":"text"},{"type":"codeVoice","code":".der"},{"text":", or ","type":"text"},{"type":"codeVoice","code":".DER"},{"text":" ","type":"text"},{"text":"file extensions.","type":"text"}],"role":"symbol","title":"certificates(in:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text"