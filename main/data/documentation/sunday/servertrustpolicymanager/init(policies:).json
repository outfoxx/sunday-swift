:"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The new "},{"type":"codeVoice","code":"ServerTrustPolicyManager"},{"type":"text","text":" instance."}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since different servers and web services can have different leaf certificates, intermediate and even root"},{"type":"text","text":" "},{"type":"text","text":"certficates, it is important to have the flexibility to specify evaluation policies on a per host basis. This"},{"type":"text","text":" "},{"type":"text","text":"allows for scenarios such as using default evaluation for host1, certificate pinning for host2, public key"},{"type":"text","text":" "},{"type":"text","text":"pinning for host3 and disabling evaluation for host4."}]}]}],"references":{"doc://Sunday/documentation/Sunday":{"type":"topic","identifier":"doc:\/\/Sunday\/documentation\/Sunday","abstract":[],"role":"collection","title":"Sunday","kind":"symbol","url":"\/documentation\/sunday"},"doc://Sunday/documentation/Sunday/ServerTrustPolicyManager":{"abstract":[{"type":"text","text":"Responsible for managing the mapping of "},{"type":"codeVoice","code":"ServerTrustPolicy"},{"type":"text","text":" objects to a given host."}],"identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicyManager","title":"ServerTrustPolicyManager","url":"\/documentation\/sunday\/servertrustpolicymanager","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ServerTrustPolicyManager"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ServerTrustPolicyManager"}],"type":"topic"},"doc://Sunday/documentation/Sunday/ServerTrustPolicyManager/init(policies:)":{"identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicyMana