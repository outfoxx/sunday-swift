"text":"The new "},{"type":"codeVoice","code":"ServerTrustPolicyManager"},{"type":"text","text":" instance."}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Since different servers and web services can have different leaf certificates, intermediate and even root"},{"type":"text","text":" "},{"type":"text","text":"certficates, it is important to have the flexibility to specify evaluation policies on a per host basis. This"},{"text":" ","type":"text"},{"type":"text","text":"allows for scenarios such as using default evaluation for host1, certificate pinning for host2, public key"},{"type":"text","text":" "},{"type":"text","text":"pinning for host3 and disabling evaluation for host4."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Sunday\/documentation\/Sunday","doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicyManager"]]},"references":{"doc://Sunday/documentation/Sunday":{"url":"\/documentation\/sunday","identifier":"doc:\/\/Sunday\/documentation\/Sunday","kind":"symbol","type":"topic","abstract":[],"role":"collection","title":"Sunday"},"doc://Sunday/documentation/Sunday/ServerTrustPolicyManager":{"url":"\/documentation\/sunday\/servertrustpolicymanager","type":"topic","role":"symbol","identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicyManager","navigatorTitle":[{"kind":"identifier","text":"ServerTrustPolicyManager"}],"title":"ServerTrustPolicyManager","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ServerTrustPolicyManager"}],"kind":"symbol","abstract":[{"type":"text","text":"Responsible for managing the mapping of "},{"type":"codeVoice","code":"ServerTrustPolicy"},{"type":"text","text":" objects to a given host."}]},"doc://Sunday/documentation/Sunday/ServerTrustPolicy":{"kind":"symbol","url":"\/documentation\/sunday\/servertrustpolicy","identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicy","type":"topic","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ServerTrustPolicy"},{"type":"text","text":" evaluates the server trust generally provided by an "},{"type":"codeVoice","code":"NSURLAuthenticationChallenge"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"connecting to a server over a secure HTTPS connection. The policy configuration then evaluates the server trust"},{"type":"text","text":" "},{"type":"text","text":"with a given set of criteria to determine whether the server trust is valid and the connection should be made."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ServerTrustPolicy"}],"navigatorTitle":[{"kind":"identifier","text":"ServerTrustPolicy"}],"role":"symbol","title":"ServerTrustPolicy"},"doc://Sunday/documentation/Sunday/ServerTrustPolicyManager/init(policies:)":{"title":"init(policies:)","identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicyManager\/init(policies:)","type":"topic","abstract":[{"text":"Initializes the ","type":"text"},{"type":"codeVoice","code":"ServerTrustPolicyManager"},{"text":" instance with the given policies.","type":"text"}],"url":"\/documentation\/sunday\/servertrustpolicymanager\/init(policies:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"policies"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:6Sunday17ServerTrustPolicyO","kind":"typeIdentifier","text":"ServerTrustPolicy"},{"kind":"text","text":"])"}],"kind":"symbol","role":"symbol"}}}