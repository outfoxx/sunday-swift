nd":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Since different servers and web services can have different leaf certificates, intermediate and even root","type":"text"},{"text":" ","type":"text"},{"text":"certficates, it is important to have the flexibility to specify evaluation policies on a per host basis. This","type":"text"},{"text":" ","type":"text"},{"text":"allows for scenarios such as using default evaluation for host1, certificate pinning for host2, public key","type":"text"},{"text":" ","type":"text"},{"text":"pinning for host3 and disabling evaluation for host4.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/sunday\/servertrustpolicymanager\/init(policies:)"]}],"hierarchy":{"paths":[["doc:\/\/Sunday\/documentation\/Sunday","doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicyManager"]]},"references":{"doc://Sunday/documentation/Sunday/ServerTrustPolicyManager":{"kind":"symbol","type":"topic","identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicyManager","title":"ServerTrustPolicyManager","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ServerTrustPolicyManager"}],"abstract":[{"type":"text","text":"Responsible for managing the mapping of "},{"code":"ServerTrustPolicy","type":"codeVoice"},{"type":"text","text":" objects to a given host."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ServerTrustPolicyManager"}],"url":"\/documentation\/sunday\/servertrustpolicymanager"},"doc://Sunday/documentation/Sunday/ServerTrustPolicy":{"kind":"symbol","type":"topic","identifier":"doc:\/\/Sunday\/documentation\/Sunday\/ServerTrustPolicy","title":"ServerTrustPolicy","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ServerTrustPolicy"}],"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ServerTrustPolicy